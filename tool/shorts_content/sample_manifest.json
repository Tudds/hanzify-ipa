      "payload": {
        "kind": "poem",
        "titleZh": "静夜思",
        "title": "Tĩnh dạ tứ (Cảm nghĩ đêm yên tĩnh)",
        "audioUrl": "https://pub-7d5fb452d3c14b469b1d630f885dfa87.r2.dev/shorts/audio/poem_jingyesi.mp3",
        "paragraphs": [
          { "zh": "床前明月光，", "pinyin": "chuáng qián míng yuè guāng", "vi": "Đầu giường ánh trăng sáng,", "startMs": 0, "endMs": 2600 },
          { "zh": "疑是地上霜。", "pinyin": "yí shì dì shàng shuāng", "vi": "Ngỡ là sương trên mặt đất.", "startMs": 2600, "endMs": 5200 },
          { "zh": "举头望明月，", "pinyin": "jǔ tóu wàng míng yuè", "vi": "Ngẩng đầu nhìn trăng sáng,", "startMs": 5200, "endMs": 7800 },
          { "zh": "低头思故乡。", "pinyin": "dī tóu sī gùxiāng", "vi": "Cúi đầu nhớ cố hương.", "startMs": 7800, "endMs": 10400 }
        ],
        "glossary": [
          { "hanzi": "明月", "pinyin": "míngyuè", "vi": "trăng sáng" },
          { "hanzi": "故乡", "pinyin": "gùxiāng", "vi": "quê hương" }
        ],
        "sourceName": "Lý Bạch (李白)"
      }
    }
  ]
