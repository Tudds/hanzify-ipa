      "payload": {
        "title": "Ở quán cà phê",
        "context": "Một đoạn thoại ngắn khi gọi đồ uống.",
        "audioUrl": "https://pub-7d5fb452d3c14b469b1d630f885dfa87.r2.dev/shorts/audio/dialogue_cafe.mp3",
        "lines": [
          {
            "speaker": "A",
            "hanzi": "你要喝什么？",
            "pinyin": "nǐ yào hē shénme",
            "vi": "Bạn muốn uống gì?",
            "startMs": 0,
            "endMs": 1900
          },
          {
            "speaker": "B",
            "hanzi": "我要一杯咖啡。",
            "pinyin": "wǒ yào yì bēi kāfēi",
            "vi": "Tôi muốn một ly cà phê.",
            "startMs": 1900,
            "endMs": 4200
          },
          {
            "speaker": "A",
            "hanzi": "好的，请稍等。",
            "pinyin": "hǎo de, qǐng shāoděng",
            "vi": "Được, xin đợi một chút.",
            "startMs": 4200,
            "endMs": 6500
          }
        ]
      }
    },
